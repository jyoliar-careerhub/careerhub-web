# 앱이 요구하는 값들 (ops-workflow#59 · #76).
# 전부 서버 전용이다 — NEXT_PUBLIC_ 접두가 없으므로 클라이언트 번들에 실리지 않는다.
# D1(토큰이 Next 서버만 아는 암호화 HttpOnly 쿠키에 산다)의 전제가 그것이다.
#
# 로컬에서는 이 파일을 `.env.local`로 복사해 값을 채운다.

# 발급자. Zitadel의 공개 주소.
ZITADEL_ISSUER=https://id.careerhub.jyo-liar.com

# careerhub 프로젝트의 careerhub-web 앱에 Zitadel이 발급한 client id.
# 선언(jyoliar-k8s의 zitadel-config.yaml)에는 없다 — 제품이 만드는 값이라
# Console 또는 관리 API에서 꺼낸다.
ZITADEL_CLIENT_ID=

# 앱이 자기 자신을 부르는 주소. redirect URI(`/auth/callback`)와
# post-logout URI(`/`)가 여기서 파생하고, Zitadel에 등록된 값과 문자 그대로 같아야 한다.
AUTH_APP_ORIGIN=http://localhost:3000

# 세션 쿠키 봉인 키 — base64로 인코딩된 32바이트.
#   openssl rand -base64 32
# 이 키를 바꾸면 기존 세션이 전부 조용히 만료된다(봉인이 풀리지 않는다).
AUTH_COOKIE_SECRET=

# api-composer의 주소. composer는 내부 전용(BFF 판정)이라 이 주소로 나가는 것은 Next 서버뿐이다 —
# 브라우저는 composer를 모른다. 클러스터 안에서는 서비스 주소가 그대로 들어온다.
API_BASE_URL=https://careerhub.jyo-liar.com/api

# 아래는 필요할 때만 — 기본값은 Zitadel의 고정 경로에서 파생한다.
# ZITADEL_AUTHORIZE_ENDPOINT=
# ZITADEL_TOKEN_ENDPOINT=
# ZITADEL_END_SESSION_ENDPOINT=
# confidential client로 바꾼 경우에만. 지금 선언은 public(AUTH_METHOD_TYPE_NONE)이다.
# ZITADEL_CLIENT_SECRET=

# auth-service(인가 원장)의 주소. 온보딩 게이트의 동의 수집이 부른다(ops-workflow#54).
# composer와 같은 성질이다: 내부 전용이라 이 주소로 나가는 것은 Next 서버뿐이고,
# NEXT_PUBLIC_ 접두가 없으므로 클라이언트 번들에 실리지 않는다.
AUTH_SERVICE_BASE_URL=https://careerhub.jyo-liar.com/auth
